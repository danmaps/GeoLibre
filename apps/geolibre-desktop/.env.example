# ArcGIS Online OAuth 2.0 — PKCE sign-in button in the ArcGIS data panel.
#
# Register your app at https://www.arcgis.com (My Content → New Item → Application).
# Set redirect URI to the URL where this app is hosted, e.g.:
#   http://gisapps.sce.com/geolibre/
#
# Leave blank (or omit) to hide the sign-in button and use manual token entry only.
VITE_ARCGIS_CLIENT_ID=
